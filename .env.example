# ============================================================
# Captain Ezz -  كابتن عز  🚖
# Environment variables
# Copy this file to .env and fill in your actual values.
# ============================================================

# Supabase Project URL (required)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Anon / Public Key (required)
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Firebase Configuration (required for push notifications)
VITE_FIREBASE_API_KEY="your_firebase_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abc123"
VITE_FIREBASE_VAPID_KEY="your_firebase_vapid_key_here"

# OpenRouteService API key (optional - for real route distances)
VITE_ORS_API_KEY="your_openrouteservice_api_key_here"

# Google Maps API key (optional - for professional maps)
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# Firebase Cloud Messaging (FCM) for Supabase Edge Function
FIREBASE_SERVICE_ACCOUNT_EMAIL="firebase-adminsdk@project.iam.gserviceaccount.com"
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FCM_PROJECT_ID="your-project-id"

# Web Push VAPID keys (for non-Firebase push notifications)
VITE_WEB_PUSH_VAPID_PUBLIC_KEY="your_web_push_vapid_public_key_here"
WEB_PUSH_VAPID_PRIVATE_KEY="your_web_push_vapid_private_key_here"
